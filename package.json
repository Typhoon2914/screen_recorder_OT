{
  "name": "screen-recorder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test:browser": "node scripts/browser-validation.mjs",
    "verify": "node scripts/verification.mjs",
    "dev": "vite build --watch",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:baseline": "node --test tests/baseline/*.test.js && npm run build",
    "test:automation": "node --test tests/automation/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:schedules": "node --test tests/schedules/*.test.js"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.1",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "obs-websocket-js": "^5.0.8"
  },
  "devDependencies": {
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.64.0",
    "vite": "^8.3.4"
  }
}
