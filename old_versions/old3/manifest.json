{
  "manifest_version": 3,
  "name": "Screen Recorder",
  "version": "1.0.0",
  "description": "Record your screen with built-in APIs. MP4 if supported, otherwise WebM.",
  "action": {
    "default_title": "Screen Recorder",
    "default_popup": "popup.html"
  },
  "permissions": ["downloads", "tabs"],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  }
}
